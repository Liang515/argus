{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.1.25",
  "identifier": "io.github.liang515.argus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        },
        "backgroundColor": "#0D0F12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "-"
    },
    "copyright": "© 2026 Liang515",
    "shortDescription": "Terminal workspace for coding agents"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQ0YzRkIwNUVGQjU5REYKUldUZldmdGVzRC9QMmc5WnVFZyt0ZG1vYXZhV3FsdmxFNVpTc1EzblQzWDJ3cFdJREhvV0NGam4K",
      "endpoints": [
        "https://github.com/Liang515/argus/releases/latest/download/latest.json"
      ]
    }
  }
}
